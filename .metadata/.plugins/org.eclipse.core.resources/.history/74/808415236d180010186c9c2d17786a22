<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
                             http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

    <!-- Servlet para Criar Livro -->
    <servlet>
        <servlet-name>CreateLivroServlet</servlet-name>
        <servlet-class>br.edu.ifsp.arq.CreateLivroServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CreateLivroServlet</servlet-name>
        <url-pattern>/criar-livro</url-pattern>
    </servlet-mapping>

 
    <servlet>
        <servlet-name>DeleteLivroServlet</servlet-name>
        <servlet-class>br.edu.ifsp.arq.DeleteLivroServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteLivroServlet</servlet-name>
        <url-pattern>/DeleteLivroServlet</url-pattern>
    </servlet-mapping>


    <servlet>
        <servlet-name>ReadLivroServlet</servlet-name>
        <servlet-class>br.edu.ifsp.arq.ReadLivroServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReadLivroServlet</servlet-name>
        <url-pattern>/ReadLivroServlet</url-pattern>
    </servlet-mapping>

   
    <servlet>
        <servlet-name>UpdateLivroServlet</servlet-name>
        <servlet-class>br.edu.ifsp.arq.UpdateLivroServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateLivroServlet</servlet-name>
        <url-pattern>/UpdateLivroServlet</url-pattern>
    </servlet-mapping>

</web-app>
